{
  "name": "employee-internal-transfer",
  "version": "1.0.0",
  "description": "Employee Internal Transfer Digital Journey - INT SDD Modular Monolith",
  "main": "src/backend/app/server.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc"
  },
  "keywords": [
    "sdd",
    "employee-transfer",
    "modular-monolith"
  ],
  "author": "INT Global",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "express": "^4.19.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@backend/(.*)$": "<rootDir>/src/backend/$1",
      "^@frontend/(.*)$": "<rootDir>/src/frontend/$1"
    }
  }
}
